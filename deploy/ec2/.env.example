# Docker image versions. `main` is convenient for the demo; a commit SHA can be
# used here when a precise rollback is required.
BACKEND_IMAGE_TAG=main
FRONTEND_IMAGE_TAG=main

# Public ports exposed by the EC2 instance.
BACKEND_PORT=8080
FRONTEND_PORT=4173

# MySQL is reachable only from the internal Compose network.
MYSQL_DATABASE=ai_repair_assistant
MYSQL_USER=repair_assistant
MYSQL_PASSWORD=replace-with-a-strong-password
MYSQL_ROOT_PASSWORD=replace-with-another-strong-password

# Qdrant is also internal-only. Leave the API key empty for this single-host
# demo because its port is not published to the Internet.
QDRANT_API_KEY=
QDRANT_COLLECTION=ai_repair_knowledge_v1

# Server-side OpenAI configuration. Never expose this key as a VITE variable.
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_RECORDING_CONNECT_TIMEOUT_SECONDS=15
OPENAI_RECORDING_READ_TIMEOUT_SECONDS=180
OPENAI_CHAT_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=512
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe-diarize
SPEAKER_ROLE_CONFIDENCE_THRESHOLD=0.75

# Persistent EBS-backed host directory mounted into the backend container.
RECORDING_HOST_PATH=/opt/ai-repair-assistant/data/recordings
RECORDING_RETENTION_DAYS=30
RECORDING_MAX_FILE_SIZE_BYTES=104857600
RECORDING_MAX_FILES_PER_BATCH=10
RECORDING_WORKER_CONCURRENCY=2

# Replace the host with the EC2 Elastic IP or domain used by the browser.
FRONTEND_ORIGIN=http://EC2_PUBLIC_IP:4173

KNOWLEDGE_IMPORT_ENABLED=true
KNOWLEDGE_VERSION=demo-v1
